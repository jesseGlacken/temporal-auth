# Temporal Auth Configuration
TEMPORAL_OIDC_ISSUER_URL=https://oidc.provider.com
TEMPORAL_OIDC_CLIENT_ID=your-client-id-here
TEMPORAL_OIDC_CLIENT_SECRET=your-client-secret-here

# Temporal UI callback URL (adjust host/port if not running on localhost:8080)
TEMPORAL_AUTH_CALLBACK_URL=http://localhost:8080/auth/sso/callback

# PostgreSQL (consumed at runtime by docker/temporal-config.yaml and
# server/config/development.yaml via Temporal's "# enable-template" support).
# Names match the upstream temporalio/docker-compose .env so one file feeds both.
# Generate a password with: openssl rand -base64 24
POSTGRES_USER=temporal
POSTGRES_PWD=
# POSTGRES_SEEDS=postgresql
# DB_PORT=5432
# DBNAME=temporal
# VISIBILITY_DBNAME=temporal_visibility
# SQL_TLS_ENABLED=false

# OpenSearch visibility (docker compose only)
# ES_SCHEME=http
# ES_SEEDS=opensearch
# ES_PORT=9200

# TEMPORAL_LOG_LEVEL=info
